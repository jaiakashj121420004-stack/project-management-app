# Cloudflare Pages response headers.
#
# The root cause of the 2026-08-15 "entire app renders unstyled" incident was a
# STALE index.html being served after a fresh deploy: it still referenced the
# previous build's content-hashed /assets/ files, which no longer existed.
#
# Vite's build output is content-hashed, so /assets/* filenames change whenever
# their contents change and can safely be cached forever. index.html must NOT
# be — it is the pointer to whichever asset hashes are current, so a cached copy
# of it is exactly what breaks a deploy. `no-cache` doesn't mean "never store";
# it means "always revalidate before use", so the browser/edge still gets a fast
# 304 when nothing changed, but can never serve a stale pointer.
/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

# Content-hashed build output — immutable by construction.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker itself must always be revalidated, otherwise a stale copy
# keeps controlling the page and serving its own cached (old) index.html.
/sw.js
  Cache-Control: no-cache
